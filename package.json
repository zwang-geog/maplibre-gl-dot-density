{
  "name": "maplibre-gl-dot-density",
  "version": "0.1.0",
  "description": "Dot density layer for polygon vector tiles (PMTiles or XYZ). For MapLibre GL JS and Mapbox GL JS.",
  "keywords": [
    "dot-density",
    "mapbox",
    "mapbox-gl-js",
    "maplibre",
    "maplibre-gl-js",
    "custom-layer",
    "web-map",
    "vector-tiles",
    "pmtiles",
    "mvt",
    "webgl"
  ],
  "author": "Zifan Wang",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "mapbox-gl": ">=3",
    "maplibre-gl": ">=4 <7"
  },
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.4",
    "earcut": "^3.0.1",
    "pbf": "^4.0.1",
    "pmtiles": "^4.3.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "mapbox-gl": "^3.35.2",
    "maplibre-gl": "^5.7.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  }
}
